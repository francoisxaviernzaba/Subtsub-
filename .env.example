# ======================================================================
# SUB2SUB — Environment configuration
# ----------------------------------------------------------------------
# For Vercel: install the Neon integration (Storage → Marketplace → Neon).
# It auto-injects DATABASE_URL. You only need to fill the other vars.
# Local dev: fill DATABASE_URL with a Neon connection string (free at
# https://neon.tech) and copy to .env
# ======================================================================

# --- Database (Neon / Postgres) ---
# Get a free connection string at https://neon.tech
# Format: postgresql://USER:PASS@HOST.neon.tech/DBNAME?sslmode=require
# On Vercel, this is auto-injected by the Neon integration.
DATABASE_URL="postgresql://USER:PASS@HOST.neon.tech/DBNAME?sslmode=require"

# --- SINGLE-SECRET MODE (recommended for Vercel) ---
# Instead of pasting 10+ env vars, run `pnpm secrets:encrypt` locally to
# generate one encrypted blob. Then paste it as SECRETS_BLOB below.
# Master key is required to decrypt it. Use the same value as TOKEN_ENC_KEY.
#
#   pnpm secrets:encrypt   # → produces .env.secrets.json template
#   # fill .env.secrets.json with your real values
#   pnpm secrets:encrypt   # → prints one SECRETS_BLOB value
#   # paste it into Vercel as a single env var
#
SECRETS_BLOB=""
SECRETS_MASTER_KEY=""

# --- Individual env vars (only needed if SECRETS_BLOB is NOT set) ---

NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

YOUTUBE_API_KEY=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/youtube/callback"
TOKEN_ENC_KEY=""

PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

CRYPTOMUS_MERCHANT_ID=""
CRYPTOMUS_API_KEY=""

ADMIN_EMAILS=""
