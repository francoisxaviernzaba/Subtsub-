# ======================================================================
# SUB2SUB — Environment configuration
# ----------------------------------------------------------------------
# For Vercel: install the Neon integration (Storage → Marketplace → Neon).
# It auto-injects DATABASE_URL. You only need to fill the other vars.
# Local dev: fill DATABASE_URL with a Neon connection string (free at
# https://neon.tech) and copy to .env
# ======================================================================

# --- Database (Neon / Postgres) ---
# Get a free connection string at https://neon.tech
# Format: postgresql://USER:PASS@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL="postgresql://USER:PASS@HOST.neon.tech/DBNAME?sslmode=require"

# --- NextAuth ---
# Set to your deployed URL in production, e.g. https://sub2sub.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Google OAuth (NextAuth) ---
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- YouTube Data API v3 (public, key-based) ---
# Same Google Cloud project → Enable "YouTube Data API v3" → Create API key
YOUTUBE_API_KEY=""

# --- YouTube OAuth 2.0 (for verifying subscriptions) ---
# Create another OAuth client (Web application)
# Authorized redirect URI: ${NEXTAUTH_URL}/api/youtube/callback
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/youtube/callback"

# --- Token encryption (32 bytes, base64) ---
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=""

# --- Payment provider abstraction ---
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Admin bootstrap (comma-separated) ---
ADMIN_EMAILS=""
