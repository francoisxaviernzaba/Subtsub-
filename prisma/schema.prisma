// SUB2SUB Prisma schema
// Uses SQLite for sandbox. Switch provider to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  username      String?  @unique
  role          String   @default("USER") // USER | ADMIN
  status        String   @default("ACTIVE") // ACTIVE | SUSPENDED | BANNED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime?

  // relations
  accounts        Account[]
  sessions        Session[]
  youtubeChannel  YouTubeChannel?
  campaigns       Campaign[]
  taskCompletions TaskCompletion[]
  coinTxns        CoinTransaction[]
  notifications   Notification[]
  payments        Payment[]
  idempotencyKeys IdempotencyKey[]
  adminActions    AdminAction[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// YOUTUBE
// ============================================================

model YouTubeChannel {
  id            String   @id @default(cuid())
  userId        String   @unique // one channel per user (db-level)
  youtubeId     String   @unique // channel ID from YouTube (UC...)
  handle        String?  // @handle if known
  title         String
  description   String?
  thumbnailUrl  String?
  subscriberCount Int?
  videoCount    Int?
  verified      Boolean  @default(false)
  verifiedAt    DateTime?
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // encrypted OAuth token blob (server-only); base64 of encrypted JSON
  // (kept here for sandbox; in prod use KMS / libsodium)
  accessTokenCipher  String?
  refreshTokenCipher String?
  tokenExpiresAt     DateTime?
  scope              String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([youtubeId])
}

model YouTubeCache {
  // generic cache for channel/video lookups to avoid quota burn
  key         String   @id // e.g. "channel:UCxxxx" or "video:yyyy"
  payload     String   // JSON
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

// ============================================================
// CAMPAIGNS
// ============================================================

model Campaign {
  id              String   @id @default(cuid())
  ownerId         String
  type            String   // VIDEO_VIEW | SUBSCRIBER
  status          String   @default("DRAFT") // DRAFT | PENDING_REVIEW | ACTIVE | PAUSED | COMPLETED | REJECTED | EXHAUSTED
  youtubeVideoId  String?  // for VIDEO_VIEW
  youtubeChannelId String? // for SUBSCRIBER (target channel)
  title           String
  thumbnailUrl    String?
  rewardPerAction Int
  totalBudget     Int
  spentBudget     Int      @default(0)
  maxActions      Int
  completedActions Int     @default(0)
  minWatchSeconds Int      @default(30) // for VIDEO_VIEW
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  taskCompletions TaskCompletion[]

  @@index([ownerId])
  @@index([status, type])
  @@index([youtubeVideoId])
  @@index([youtubeChannelId])
}

// ============================================================
// TASK COMPLETIONS / VERIFICATION
// ============================================================

model TaskCompletion {
  id            String   @id @default(cuid())
  userId        String
  campaignId    String
  // subscription dedupe: per (user, targetChannelId)
  targetChannelId String?
  // view dedupe: per (user, campaignId) — a user can only earn once per campaign (configurable)
  state         String   @default("PENDING") // PENDING | VERIFIED | REVOKED | FAILED | EXPIRED
  rewardCoins   Int      @default(0)
  watchSeconds  Int?
  verifiedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  idempotencyKey String? @unique

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Composite unique — one completion per (user, campaign, targetChannel).
  // For VIDEO_VIEW: targetChannelId is null → (user, campaign, NULL) is unique.
  // For SUBSCRIBER: same user can't earn twice for the same target channel in the same campaign.
  // Combined with the app-level check below, this is a robust DB-level guard.
  @@unique([userId, campaignId, targetChannelId])
  @@index([userId, targetChannelId])
  @@index([campaignId, state])
  @@index([userId, state])
}

// Dedup rules additionally enforced at app level (in atomic tx):
//   SUBSCRIBER: at most one VERIFIED/PENDING completion per (userId, targetChannelId) across all campaigns
//   VIDEO_VIEW: at most one VERIFIED/PENDING completion per (userId, campaignId)

// ============================================================
// COIN ECONOMY (double-entry ledger)
// ============================================================

model CoinTransaction {
  id              String   @id @default(cuid())
  userId          String
  // positive = credit, negative = debit
  deltaCoins      Int
  balanceAfter    Int
  type            String   // VIEW_REWARD | SUBSCRIBE_REWARD | BOOST_SPEND | COIN_PURCHASE | ADMIN_ADJUSTMENT | REFUND | REVERSAL
  referenceType   String?  // e.g. "TaskCompletion" | "Campaign" | "Payment"
  referenceId     String?
  note            String?
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
  @@index([referenceType, referenceId])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  kind      String   // SUBSCRIPTION_VERIFIED | VIEW_REWARD | COIN_PURCHASE | CAMPAIGN_ACTIVATED | CAMPAIGN_COMPLETED | CAMPAIGN_REJECTED | BUDGET_EXHAUSTED | ACCOUNT_EVENT | YT_CONNECTION
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id              String   @id @default(cuid())
  userId          String
  provider        String   // "stripe" | "manual" | "mock" — abstracted
  providerRef     String?  // provider's payment id
  status          String   @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  coins           Int
  amountCents     Int
  currency        String   @default("USD")
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([provider, providerRef])
  @@index([status])
}

// ============================================================
// ADMIN / SETTINGS
// ============================================================

model SystemSetting {
  key       String   @id
  value     String   // JSON
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AdminAction {
  id        String   @id @default(cuid())
  adminId   String
  action    String   // ADJUST_COINS | SET_REWARD | BAN_USER | REJECT_CAMPAIGN | ...
  targetType String?
  targetId   String?
  payload   String?  // JSON snapshot
  note      String?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

// ============================================================
// IDEMPOTENCY
// ============================================================

model IdempotencyKey {
  key       String   @id
  userId    String
  endpoint  String
  result    String?  // JSON of previous successful response
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
